{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "top_skills",
  "position": {
    "x": 842,
    "y": 488,
    "z": 502,
    "height": 208,
    "width": 389,
    "tabOrder": 502
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimSkill"
                    }
                  },
                  "Property": "skillDescription"
                }
              },
              "queryRef": "DimSkill.skillDescription",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactJob"
                    }
                  },
                  "Property": "Skill Job Count"
                }
              },
              "queryRef": "FactJob.Skill Job Count"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Top Skills / 關聯職缺數'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
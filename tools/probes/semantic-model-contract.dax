DEFINE
    VAR SkillCodes = TOPN(2, VALUES('dim_技能'[技能代碼]), 'dim_技能'[技能代碼], ASC)
    VAR CategoryCodes = TOPN(2, VALUES('dim_職類'[職類代碼]), 'dim_職類'[職類代碼], ASC)
    VAR SkillCategoryPairs = FILTER(
        CROSSJOIN(VALUES('dim_技能'[技能代碼]), VALUES('dim_職類'[職類代碼])),
        CALCULATE([目前符合條件職缺數]) > 0
    )
    VAR ChosenPair = TOPN(1, SkillCategoryPairs, 'dim_技能'[技能代碼], ASC, 'dim_職類'[職類代碼], ASC)
    VAR PairSkills = SELECTCOLUMNS(ChosenPair, "SkillCode", 'dim_技能'[技能代碼])
    VAR PairCategories = SELECTCOLUMNS(ChosenPair, "CategoryCode", 'dim_職類'[職類代碼])
    VAR ActualSkill = CALCULATE([技能篩選職缺數], TREATAS(SkillCodes, 'dim_技能'[技能代碼]))
    VAR ExpectedSkill = CALCULATE(
    DISTINCTCOUNT('職缺技能對照'[職缺編號]),
    TREATAS(SkillCodes, 'dim_技能'[技能代碼]),
    CROSSFILTER('職缺技能對照'[職缺編號], '目前職缺'[職缺編號], BOTH)
)
    VAR ActualCategory = CALCULATE([職類篩選職缺數], TREATAS(CategoryCodes, 'dim_職類'[職類代碼]))
    VAR ExpectedCategory = CALCULATE(
    DISTINCTCOUNT('職缺職類對照'[職缺編號]),
    TREATAS(CategoryCodes, 'dim_職類'[職類代碼]),
    CROSSFILTER('職缺職類對照'[職缺編號], '目前職缺'[職缺編號], BOTH)
)
    VAR ActualIntersection = CALCULATE(
        [目前符合條件職缺數],
        TREATAS(PairSkills, 'dim_技能'[技能代碼]),
        TREATAS(PairCategories, 'dim_職類'[職類代碼])
    )
    VAR ExpectedIntersection = CALCULATE(
        DISTINCTCOUNT('目前職缺'[職缺編號]),
        TREATAS(PairSkills, 'dim_技能'[技能代碼]),
        TREATAS(PairCategories, 'dim_職類'[職類代碼]),
        CROSSFILTER('職缺技能對照'[職缺編號], '目前職缺'[職缺編號], BOTH),
        CROSSFILTER('職缺職類對照'[職缺編號], '目前職缺'[職缺編號], BOTH)
    )
    VAR SkillJobs = TOPN(1, VALUES('職缺技能對照'[職缺編號]), '職缺技能對照'[職缺編號], ASC)
    VAR JobSkillsText = CALCULATE([職缺技能清單], TREATAS(SkillJobs, '目前職缺'[職缺編號]))
    VAR OrphanAppearDates = COALESCE(COUNTROWS(EXCEPT(
        DISTINCT(SELECTCOLUMNS(FILTER('目前職缺', NOT ISBLANK('目前職缺'[刊登日期])), "Date", '目前職缺'[刊登日期])),
        SELECTCOLUMNS('dim_日期', "Date", 'dim_日期'[日期])
    )), 0)
EVALUATE
ROW(
    "FactJobs", COUNTROWS('目前職缺'),
    "ActiveJobs", [目前符合條件職缺數],
    "Companies", [符合條件公司數],
    "SalaryCoverage", [薪資上下限涵蓋率],
    "SkillActual", ActualSkill,
    "SkillExpected", ExpectedSkill,
    "CategoryActual", ActualCategory,
    "CategoryExpected", ExpectedCategory,
    "IntersectionActual", ActualIntersection,
    "IntersectionExpected", ExpectedIntersection,
    "IntersectionPairFound", COUNTROWS(ChosenPair) = 1,
    "JobSkillsPopulated", NOT ISBLANK(JobSkillsText),
    "OrphanAppearDates", OrphanAppearDates,
    "SkillPassed", ActualSkill = ExpectedSkill,
    "CategoryPassed", ActualCategory = ExpectedCategory,
    "IntersectionPassed", ActualIntersection = ExpectedIntersection,
    "DateContractPassed", OrphanAppearDates = 0
)

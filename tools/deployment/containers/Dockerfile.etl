FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY tools/requirements-dev.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt

COPY tools /app/tools
COPY powerquery/archive/pre-db-etl/01_functions/fx104GetPage.pq \
    /app/powerquery/archive/pre-db-etl/01_functions/fx104GetPage.pq

CMD ["python", "-m", "tools.acquisition.platforms.jobwant_104.distributed.worker"]

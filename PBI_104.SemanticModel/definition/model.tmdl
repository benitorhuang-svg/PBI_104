model Model
	culture: zh-TW
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 00_Parameters

queryGroup 01_Functions

queryGroup 02_Source

queryGroup 03_Staging

queryGroup 04_Model

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["pArea", "pBaseUrl", "pJobSource", "pKeyword", "pMode", "pOrder", "pPage", "pPageSize", "pSnapshotRoot", "pSourceMode", "fx104GetAllPages", "fx104GetPage", "fx104ReadBatch", "fx104ValidatePage", "fxAreaKey", "fxNormalizeText", "fxParseJsonList", "fxStageJobs", "fxStrictNumber", "src_104CurrentManifest", "src_104HistoryJobs", "src_104Jobs", "src_104Metadata", "src_104Result", "stg_Areas", "stg_Companies", "stg_DataQuality", "stg_JobCategories", "stg_JobHistory", "stg_Jobs", "stg_JobSkills", "stg_Skills", "mdl_BridgeJobCategory", "mdl_BridgeJobSkill", "mdl_DimArea", "mdl_DimCompany", "mdl_DimJobCategory", "mdl_DimSkill", "mdl_FactJob", "mdl_FactJobSnapshot"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table FactJob
ref table FactJobSnapshot
ref table DimCompany
ref table DimArea
ref table DimSkill
ref table DimJobCategory
ref table BridgeJobSkill
ref table BridgeJobCategory
ref table DimDate

ref cultureInfo zh-TW


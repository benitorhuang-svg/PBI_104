table FactJob
	lineageTag: e01bc894-c60a-4e83-849b-cde9f0a28fda

	/// Distinct current jobNo values in the loaded FactJob refresh, propagating skill and category filter selections through their bridge tables.
	measure 'Active Jobs' =
		VAR HasSkillFilter = ISFILTERED(DimSkill[skillDescription]) || ISFILTERED(DimSkill[skillCode])
		VAR HasCategoryFilter = ISFILTERED(DimJobCategory[jobCatDescription]) || ISFILTERED(DimJobCategory[jobCatCode])
		RETURN
		IF(
			HasSkillFilter && HasCategoryFilter,
			CALCULATE(
				DISTINCTCOUNT(FactJob[jobNo]),
				CROSSFILTER(BridgeJobSkill[jobNo], FactJob[jobNo], Both),
				CROSSFILTER(BridgeJobCategory[jobNo], FactJob[jobNo], Both)
			),
			IF(
				HasSkillFilter,
				CALCULATE(DISTINCTCOUNT(FactJob[jobNo]), CROSSFILTER(BridgeJobSkill[jobNo], FactJob[jobNo], Both)),
				IF(
					HasCategoryFilter,
					CALCULATE(DISTINCTCOUNT(FactJob[jobNo]), CROSSFILTER(BridgeJobCategory[jobNo], FactJob[jobNo], Both)),
					DISTINCTCOUNT(FactJob[jobNo])
				)
			)
		)
		formatString: #,0
		displayFolder: Jobs
		lineageTag: e576effe-a723-4f26-b829-15d17a446219

	/// Distinct jobs represented by the validated jobNo × jobCatCode bridge under the current filter context.
	measure 'Category Job Count' = DISTINCTCOUNT(BridgeJobCategory[jobNo])
		formatString: #,0
		displayFolder: Categories
		lineageTag: c314b901-7fa2-4be0-82a1-a7b2184c901e

	/// Share of current jobs associated with the selected job category. This describes association, not causation.
	measure 'Category Share %' = DIVIDE([Category Job Count], CALCULATE([Active Jobs], REMOVEFILTERS(DimJobCategory)), 0)
		formatString: 0.0%
		displayFolder: Categories
		lineageTag: d85a2104-51bc-4e4b-9e0a-bf1930b8c6e2

	/// Distinct custNo values represented by the current FactJob refresh.
	measure 'Company Count' = DISTINCTCOUNT(FactJob[custNo])
		formatString: #,0
		displayFolder: Companies
		lineageTag: d79a642c-479c-4e17-b1fe-e81a5568ad8d

	/// Rows with both numeric salary bounds present. The measure does not reinterpret zero or 9999999; salary availability and units remain unresolved.
	measure 'Jobs with Salary' = COUNTROWS(FILTER(FactJob, NOT ISBLANK(FactJob[salaryLow]) && NOT ISBLANK(FactJob[salaryHigh])))
		formatString: #,0
		displayFolder: Salary
		lineageTag: ddd9a331-14db-43b8-9316-6e0da72efdc2

	/// Jobs with both reported numeric salary bounds divided by current distinct jobs. This is raw-bound coverage, not a claim that the values are disclosed salary.
	measure 'Salary Coverage %' = DIVIDE([Jobs with Salary], [Active Jobs], 0)
		formatString: 0.0%
		displayFolder: Salary
		lineageTag: 1a453a7e-4a28-4c7b-b5b0-9fced4a7ca4d

	/// Sum of the API applyCnt field for the current refresh. The business interpretation of applyCnt is not independently confirmed.
	measure 'Job Applications' = SUM(FactJob[applyCnt])
		formatString: #,0
		displayFolder: Applications
		lineageTag: a439b490-bce5-4d1f-accf-ff1d1ac7acaf

	/// Distinct jobs represented by the validated jobNo × skillCode bridge under the current filter context.
	measure 'Skill Job Count' = DISTINCTCOUNT(BridgeJobSkill[jobNo])
		formatString: #,0
		displayFolder: Skills
		lineageTag: cac87f8d-6ddc-4a9f-bd2f-86fab1d4368c

	/// Share of current jobs associated with the selected normalized skill. This describes association, not causation.
	measure 'Skill Share %' = DIVIDE([Skill Job Count], CALCULATE([Active Jobs], REMOVEFILTERS(DimSkill)), 0)
		formatString: 0.0%
		displayFolder: Skills
		lineageTag: fbac9dd5-be67-471f-8cc8-0f0d3537c804


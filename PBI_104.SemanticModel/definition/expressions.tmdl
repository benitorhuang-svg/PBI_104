expression mdl_FactJobSnapshot = ```
		let
		    Source = stg_Jobs,
		    InvalidKeyRows =
		        Table.SelectRows(
		            Source,
		            each [jobNo] = null or [jobNo] = "" or [snapshotDate] = null or [snapshotDate] = ""
		        ),
		    WithSnapshotDate =
		        Table.AddColumn(

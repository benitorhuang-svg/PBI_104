expression fx104GetAllPages = ```
		(
		    baseUrl as text,
		    keyword as text,
		    area as text,
		    jobsource as text,
		    mode as text,
		    order as text,
		    startPage as number,
		    pagesize as number,
		    optional maxPages as nullable number
		) as record =>
		let
		    StartPage =
		        if startPage < 1 or Number.RoundDown(startPage) <> startPage then
		            error Error.Record("Invalid start page", "startPage must be a positive integer.", null)
		        else startPage,
		    PageLimit = if maxPages = null then 1000 else maxPages,
		    FirstPage =
		        fx104ValidatePage(fx104GetPage(
		            baseUrl,
		            keyword,
		            area,
		            jobsource,
		            mode,
		            order,
		            StartPage,
		            pagesize
		        ), StartPage),
		    FirstMetadata = FirstPage[Metadata],
		    CurrentPageValue =
		        if Table.HasColumns(FirstMetadata, "currentPage") then
		            try Int64.From(FirstMetadata{0}[currentPage]) otherwise null
		        else
		            null,
		    LastPageValue =
		        if Table.HasColumns(FirstMetadata, "lastPage") then
		            try Int64.From(FirstMetadata{0}[lastPage]) otherwise null
		        else
		            null,
		    ValidatedLastPage =
		        if CurrentPageValue = null then
		            error Error.Record(
		                "Pagination metadata missing",
		                "$.metadata.pagination.currentPage was not available.",
		                [RequestedPage = StartPage]
		            )
		        else if CurrentPageValue <> StartPage then
		            error Error.Record(
		                "Pagination page mismatch",
		                "The API currentPage did not match the requested page.",
		                [RequestedPage = StartPage, CurrentPage = CurrentPageValue]
		            )
		        else if LastPageValue = null or LastPageValue < 0 then
		            error Error.Record(
		                "Pagination metadata missing",
		                "$.metadata.pagination.lastPage was not a non-negative integer.",
		                [RequestedPage = StartPage, LastPage = LastPageValue]
		            )
		        else if PageLimit < 1 or Number.RoundDown(PageLimit) <> PageLimit or LastPageValue - StartPage + 1 > PageLimit then
		            error Error.Record("Acquisition page guard", "Invalid or exceeded maxPages; this is an operational guard, not an API limit.", [MaxPages = PageLimit])
		        else
		            LastPageValue,
		    RemainingPageNumbers =
		        if ValidatedLastPage > StartPage then
		            {StartPage + 1 .. ValidatedLastPage}
		        else
		            {},
		    RemainingPages =
		        List.Transform(
		            RemainingPageNumbers,
		            (currentPage as number) =>
		                fx104ValidatePage(fx104GetPage(
		                    baseUrl,
		                    keyword,
		                    area,
		                    jobsource,
		                    mode,
		                    order,
		                    currentPage,
		                    pagesize
		                ), currentPage, ValidatedLastPage, FirstMetadata{0}[total])
		        ),
		    PageRecords = List.Buffer({FirstPage} & RemainingPages),
		    Jobs = Table.Combine(List.Transform(PageRecords, each _[Jobs])),
		    Metadata = Table.Combine(List.Transform(PageRecords, each _[Metadata])),
		    RawResponses = Table.Combine(List.Transform(PageRecords, each _[RawResponse])),
		    ValidatedJobs =
		        if StartPage = 1 and Table.RowCount(Jobs) <> FirstMetadata{0}[total] then
		            error Error.Record("Incomplete acquisition", "Returned rows do not match the API total.", [Rows = Table.RowCount(Jobs), Total = FirstMetadata{0}[total]])
		        else Jobs
		in
		    [
		        Jobs = ValidatedJobs,
		        Metadata = Metadata,
		        RawResponses = RawResponses
		    ]
		```
	lineageTag: 000bba46-a82d-4d2b-bc28-6cff37d90bab
	queryGroup: 01_Functions

expression fx104GetPage = ```
		(
		    baseUrl as text,
		    optional keyword as nullable text,
		    optional area as nullable text,
		    optional jobsource as nullable text,
		    optional mode as nullable text,
		    optional order as nullable text,
		    optional page as nullable number,
		    optional pagesize as nullable number
		) as record =>
		let
		    NormalizedBaseUrl = Text.Trim(baseUrl),
		    ValidatedBaseUrl =
		        if NormalizedBaseUrl = "" then
		            error Error.Record(
		                "Missing base URL",
		                "baseUrl is required and cannot be empty.",
		                null
		            )
		        else
		            NormalizedBaseUrl,
		    Configuration =
		        #table(
		            type table
		            [
		                baseUrl = text,
		                keyword = nullable text,
		                area = nullable text,
		                jobsource = nullable text,
		                mode = nullable text,
		                order = nullable text,
		                page = nullable number,
		                pagesize = nullable number
		            ],
		            {
		                {
		                    ValidatedBaseUrl,
		                    keyword,
		                    area,
		                    jobsource,
		                    mode,
		                    order,
		                    page,
		                    pagesize
		                }
		            }
		        ),

		    PythonOutput =
		        Python.Execute(
		"
		import json
		import math
		import urllib.request
		from datetime import datetime

		import cloudscraper
		import pandas as pd

		config_row = config.iloc[0]

		BASE_URL = str(config_row['baseUrl'])

		def optional_text(value):
		    if value is None or pd.isna(value):
		        return None
		    normalized = str(value).strip()
		    return normalized if normalized else None

		def optional_positive_int(value, field_name):
		    if value is None or pd.isna(value):
		        return None
		    try:
		        numeric_value = float(value)
		    except (TypeError, ValueError) as exc:
		        raise TypeError(f'{field_name} must be an integer when provided') from exc
		    if not math.isfinite(numeric_value) or not numeric_value.is_integer():
		        raise ValueError(f'{field_name} must be an integer when provided')
		    normalized = int(numeric_value)
		    if normalized < 1:
		        raise ValueError(f'{field_name} must be greater than zero when provided')
		    return normalized

		KEYWORD = optional_text(config_row['keyword'])
		AREA = optional_text(config_row['area'])
		JOBSOURCE = optional_text(config_row['jobsource'])
		MODE = optional_text(config_row['mode'])
		ORDER = optional_text(config_row['order'])
		PAGE = optional_positive_int(config_row['page'], 'page')
		PAGE_SIZE = optional_positive_int(config_row['pagesize'], 'pagesize')

		optional_params = {
		    'area': AREA,
		    'jobsource': JOBSOURCE,
		    'keyword': KEYWORD,
		    'mode': MODE,
		    'order': ORDER,
		    'page': PAGE,
		    'pagesize': PAGE_SIZE,
		}
		params = {
		    key: value
		    for key, value in optional_params.items()
		    if value is not None
		}

		headers = {
		    'Accept': 'application/json, text/plain, */*',
		    'Accept-Language': 'zh-TW,zh;q=0.9,en-US;q=0.8,en;q=0.7',
		    'Referer': 'https://www.104.com.tw/jobs/search/',
		}

		system_proxies = urllib.request.getproxies()
		valid_proxies = {
		    key: value
		    for key, value in system_proxies.items()
		    if key.lower() in ('http', 'https')
		}

		scraper = cloudscraper.create_scraper(
		    browser={
		        'browser': 'chrome',
		        'platform': 'windows',
		        'desktop': True,
		    }
		)

		if valid_proxies:
		    scraper.proxies.update(valid_proxies)

		snapshot_dt = datetime.now().astimezone()
		snapshot_date = snapshot_dt.date().isoformat()
		snapshot_datetime = snapshot_dt.isoformat(timespec='seconds')

		try:
		    response = scraper.get(
		        BASE_URL,
		        params=params,
		        headers=headers,
		        timeout=30,
		    )
		    response.raise_for_status()
		except Exception as exc:
		    raise RuntimeError(
		        f'104 API request failed for page={PAGE}, pagesize={PAGE_SIZE}: {exc}'
		    ) from exc

		try:
		    json_data = response.json()
		except ValueError as exc:
		    raise RuntimeError(
		        f'104 API returned invalid JSON for page={PAGE}: {exc}'
		    ) from exc

		if not isinstance(json_data, dict):
		    raise TypeError(
		        f'Expected the top-level JSON value to be an object; got {type(json_data).__name__}'
		    )

		jobs_list = json_data.get('data')
		metadata_node = json_data.get('metadata')

		if not isinstance(jobs_list, list):
		    raise TypeError(
		        f'Expected $.data to be an array; got {type(jobs_list).__name__}'
		    )

		if not isinstance(metadata_node, dict):
		    raise TypeError(
		        f'Expected $.metadata to be an object; got {type(metadata_node).__name__}'
		    )

		if any(not isinstance(job, dict) for job in jobs_list):
		    raise TypeError('Expected every item in $.data to be an object')

		df_jobs = pd.DataFrame(jobs_list)

		def serialize_complex(value):
		    if isinstance(value, (dict, list)):
		        return json.dumps(
		            value,
		            ensure_ascii=False,
		            separators=(',', ':'),
		        )
		    return value

		for column_name in df_jobs.columns:
		    df_jobs[column_name] = df_jobs[column_name].map(serialize_complex)

		df_jobs['snapshotDate'] = snapshot_date
		df_jobs['snapshotDateTime'] = snapshot_datetime
		df_jobs['sourceKeyword'] = KEYWORD
		df_jobs['sourceArea'] = AREA
		df_jobs['sourcePage'] = PAGE
		df_jobs['sourcePageSize'] = PAGE_SIZE

		pagination_node = metadata_node.get('pagination')
		filter_query_node = metadata_node.get('filterQuery')
		job_keys = sorted(
		    {
		        key
		        for job in jobs_list
		        for key in job.keys()
		    }
		)

		metadata = {
		    'httpStatus': response.status_code,
		    'requestUrl': response.url,
		    'snapshotDate': snapshot_date,
		    'snapshotDateTime': snapshot_datetime,
		    'keyword': KEYWORD,
		    'area': AREA,
		    'jobsource': JOBSOURCE,
		    'mode': MODE,
		    'order': ORDER,
		    'requestedPage': PAGE,
		    'requestedPageSize': PAGE_SIZE,
		    'returnedJobs': len(jobs_list),
		    'topLevelKeys': json.dumps(list(json_data.keys()), ensure_ascii=False),
		    'dataKeys': json.dumps(job_keys, ensure_ascii=False),
		    'metadataKeys': json.dumps(list(metadata_node.keys()), ensure_ascii=False),
		    'paginationJson': json.dumps(pagination_node, ensure_ascii=False),
		    'filterQueryJson': json.dumps(filter_query_node, ensure_ascii=False),
		    'rawMetadataJson': json.dumps(metadata_node, ensure_ascii=False),
		    'count': pagination_node.get('count') if isinstance(pagination_node, dict) else None,
		    'currentPage': pagination_node.get('currentPage') if isinstance(pagination_node, dict) else None,
		    'lastPage': pagination_node.get('lastPage') if isinstance(pagination_node, dict) else None,
		    'total': pagination_node.get('total') if isinstance(pagination_node, dict) else None,
		}

		df_metadata = pd.DataFrame([metadata])
		df_raw_response = pd.DataFrame(
		    [
		        {
		            'sourcePage': PAGE,
		            'snapshotDateTime': snapshot_datetime,
		            'rawResponseJson': json.dumps(json_data, ensure_ascii=False),
		        }
		    ]
		)
		",
		            [config = Configuration]
		        ),

		    Jobs = PythonOutput{[Name = "df_jobs"]}[Value],
		    Metadata = PythonOutput{[Name = "df_metadata"]}[Value],
		    RawResponse = PythonOutput{[Name = "df_raw_response"]}[Value]
		in
		    [
		        Jobs = Jobs,
		        Metadata = Metadata,
		        RawResponse = RawResponse
		    ]
		```
	lineageTag: d2e48b9c-4e89-4db1-86f6-c299c11696da
	queryGroup: 01_Functions

expression fx104ReadBatch = ```
		(root as text, manifest as record) as record =>
		let
		    Root = Text.TrimEnd(root, {"\", "/"}),
		    RelativePath = manifest[batchPath],
		    PathParts = Text.Split(Text.Replace(RelativePath, "\", "/"), "/"),
		    BatchPath =
		        if Text.Contains(RelativePath, ":") or List.Contains(PathParts, "..") or List.Contains(PathParts, "") then
		            error Error.Record("Invalid snapshot path", "Batch paths must remain below the configured root.", null)
		        else Root & "\" & Text.Combine(PathParts, "\"),
		    Request = manifest[request],
		    SerializeComplex = (value as any) as any =>
		        if Value.Is(value, type record) or Value.Is(value, type list) then Text.FromBinary(Json.FromValue(value), TextEncoding.Utf8) else value,
		    ReadPage = (descriptor as record) as record =>
		        let
		            FileName = descriptor[file],
		            SafeFileName = if Text.Contains(FileName, "/") or Text.Contains(FileName, "\") or Text.Contains(FileName, ":") or FileName = ".." then
		                error Error.Record("Invalid snapshot page path", "Page names cannot contain path components.", null) else FileName,
		            Stored = Json.Document(File.Contents(BatchPath & "\" & SafeFileName)),
		            Response = Stored[response],
		            Pagination = Response[metadata][pagination],
		            RawRows = Response[data],
		            SerializedRows = List.Transform(RawRows, (job as record) => Record.Combine({
		                Record.TransformFields(job, List.Transform(Record.FieldNames(job), each {_, SerializeComplex})),
		                [snapshotDate = manifest[snapshotDate], snapshotDateTime = manifest[snapshotDateTime],
		                 sourceKeyword = Request[keyword], sourceArea = Request[area], sourcePage = descriptor[page], sourcePageSize = Request[pagesize]]
		            })),
		            Columns = List.Distinct(List.Combine({{"jobNo", "custNo", "pcSkills", "jobCat", "snapshotDate", "snapshotDateTime", "sourceKeyword", "sourceArea", "sourcePage", "sourcePageSize"}, List.Combine(List.Transform(SerializedRows, Record.FieldNames))})),
		            Jobs = Table.FromRecords(SerializedRows, Columns, MissingField.UseNull),
		            Metadata = Table.FromRecords({Record.Combine({Stored[technical], Pagination,
		                [snapshotDate = manifest[snapshotDate], snapshotDateTime = manifest[snapshotDateTime]]})}),
		            RawResponse = Table.FromRecords({[sourcePage = descriptor[page], snapshotDateTime = manifest[snapshotDateTime], rawResponseJson = Text.FromBinary(Json.FromValue(Response), TextEncoding.Utf8)]}),
		            PageResult = fx104ValidatePage([Jobs = Jobs, Metadata = Metadata, RawResponse = RawResponse], descriptor[page]),
		            Validated = if Table.RowCount(PageResult[Jobs]) <> descriptor[rows] or Stored[technical][httpStatus] <> 200 then
		                error Error.Record("Snapshot page mismatch", "Stored rows/status do not match the completed acquisition.", [Page = descriptor[page]]) else PageResult
		        in Validated,
		    Pages = List.Buffer(List.Transform(manifest[pages], ReadPage)),
		    FirstMetadata = Pages{0}[Metadata]{0},
		    CheckedPages = List.Transform(Pages, each fx104ValidatePage(_, _[Metadata]{0}[currentPage], FirstMetadata[lastPage], FirstMetadata[total])),
		    Jobs = Table.Combine(List.Transform(CheckedPages, each _[Jobs])),
		    PageNumbers = List.Transform(manifest[pages], each _[page]),
		    ExpectedPageNumbers = if FirstMetadata[lastPage] = 0 then {1} else {1 .. FirstMetadata[lastPage]},
		    ValidatedJobs = if PageNumbers <> ExpectedPageNumbers or Table.RowCount(Jobs) <> manifest[rows] or Table.RowCount(Jobs) <> FirstMetadata[total] then
		        error Error.Record("Incomplete snapshot batch", "Stored pages/rows do not match the completed manifest.", null) else Jobs
		in
		    [Jobs = ValidatedJobs, Metadata = Table.Combine(List.Transform(CheckedPages, each _[Metadata])), RawResponses = Table.Combine(List.Transform(CheckedPages, each _[RawResponse]))]
		```
	lineageTag: 34263720-3872-4748-b620-1c1ef6c5ef23
	queryGroup: 01_Functions

expression fx104ValidatePage = ```
		(pageResult as record, requestedPage as number, optional expectedLastPage as nullable number, optional expectedTotal as nullable number) as record =>
		let
		    Metadata = Table.Buffer(pageResult[Metadata]),
		    Jobs = Table.Buffer(pageResult[Jobs]),
		    Required = {"currentPage", "lastPage", "total", "count"},
		    ValidMetadata =
		        if Table.RowCount(Metadata) <> 1 or not Table.HasColumns(Metadata, Required) then
		            error Error.Record("Pagination metadata missing", "Each page requires one complete pagination record.", [Page = requestedPage])
		        else Metadata{0},
		    ReadInteger = (field as text) as number =>
		        let PaginationValue = Record.Field(ValidMetadata, field)
		        in if not Value.Is(PaginationValue, type number) then
		            error Error.Record("Invalid pagination integer", field & " must be numeric.", [Page = requestedPage])
		        else if PaginationValue < 0 or Number.RoundDown(PaginationValue) <> PaginationValue then
		            error Error.Record("Invalid pagination integer", field & " must be a non-negative integer.", [Page = requestedPage])
		        else PaginationValue,
		    CurrentPage = ReadInteger("currentPage"),
		    LastPage = ReadInteger("lastPage"),
		    Total = ReadInteger("total"),
		    Count = ReadInteger("count"),
		    RowCount = Table.RowCount(Jobs),
		    Validated =
		        if CurrentPage <> requestedPage then
		            error Error.Record("Pagination page mismatch", "The returned page does not match the request.", [RequestedPage = requestedPage, CurrentPage = CurrentPage])
		        else if Count <> RowCount then
		            error Error.Record("Pagination count mismatch", "Pagination count does not match the returned rows.", [Page = requestedPage, Count = Count, Rows = RowCount])
		        else if (Total = 0 and (LastPage <> 0 or Count <> 0)) or (Total > 0 and (LastPage < requestedPage or Count = 0)) then
		            error Error.Record("Inconsistent pagination", "The page is inconsistent with total/lastPage.", [Page = requestedPage])
		        else if expectedLastPage <> null and LastPage <> expectedLastPage then
		            error Error.Record("Pagination changed", "lastPage changed during acquisition; retry the complete batch.", [Page = requestedPage])
		        else if expectedTotal <> null and Total <> expectedTotal then
		            error Error.Record("Pagination changed", "total changed during acquisition; retry the complete batch.", [Page = requestedPage])
		        else [Jobs = Jobs, Metadata = Metadata, RawResponse = pageResult[RawResponse]]
		in
		    Validated
		```
	lineageTag: 48623865-4727-4cde-a1ad-8f5f47b105af
	queryGroup: 01_Functions

expression fxAreaKey = ```
		(location as record) as text =>
		    Text.Combine(
		        {
		            if location[jobAddrNo] = null then "" else Text.From(location[jobAddrNo], "en-US"),
		            if location[jobAddrNoDesc] = null then "" else location[jobAddrNoDesc],
		            if location[jobAddress] = null then "" else location[jobAddress],
		            if location[lat] = null then "" else Number.ToText(location[lat], "G", "en-US"),
		            if location[lon] = null then "" else Number.ToText(location[lon], "G", "en-US")
		        },
		        "|"
		    )
		```
	lineageTag: ac2e08a9-b965-4f9e-9872-abf4738e11fd
	queryGroup: 01_Functions

expression fxNormalizeText = ```
		(value as any) as nullable text =>
		let
		    Result = if value = null then null else
		        if Value.Is(value, type text) or Value.Is(value, type number) then
		            Text.Trim(Text.Clean(Text.From(value, "en-US")))
		        else error Error.Record("Text shape", "Expected a text or numeric scalar.", null)
		in
		    Result
		```
	lineageTag: 6a0dd4af-e007-4550-8425-2924e159aea5
	queryGroup: 01_Functions

expression fxParseJsonList = ```
		(value as any, fieldName as text) as list =>
		let
		    Parsed = if value = null then {} else if Value.Is(value, type list) then value else
		        if Value.Is(value, type text) then Json.Document(value) else
		        error Error.Record("Nested shape", "Expected a JSON list.", [Field = fieldName]),
		    Validated = if Value.Is(Parsed, type list) then Parsed else
		        error Error.Record("Nested shape", "Expected a JSON list; records and scalar values are invalid.", [Field = fieldName])
		in
		    Validated
		```
	lineageTag: 6532b2c5-9ee3-41d5-a3f3-8f222152d46a
	queryGroup: 01_Functions

expression fxStageJobs = ```
		(input as table) as table =>
		let
		    Raw = Table.Buffer(input),
		    IdentityColumns = List.RemoveItems(Table.ColumnNames(Raw), {"sourcePage"}),
		    GroupedRaw = Table.Group(Raw, {"jobNo"}, {
		        {"variants", each Table.RowCount(Table.Distinct(Table.SelectColumns(_, IdentityColumns))), Int64.Type},
		        {"firstRow", each Table.First(_), type record}}),
		    Conflicts = Table.SelectRows(GroupedRaw, each [variants] > 1),
		    UniqueRaw = if Table.RowCount(Conflicts) > 0 then
		        error Error.Record("Conflicting job duplicate", "A jobNo has different raw values within one batch.", [Jobs = Conflicts[jobNo]])
		        else Table.FromRecords(GroupedRaw[firstRow], Table.ColumnNames(Raw), MissingField.UseNull),
		    Selected = Table.SelectColumns(UniqueRaw, {
		        "jobNo", "custNo", "custName", "coIndustry", "coIndustryDesc", "jobName", "description",
		        "descSnippet", "jobAddress", "jobAddrNo", "jobAddrNoDesc", "lat", "lon", "salaryLow",
		        "salaryHigh", "appearDate", "applyCnt", "jobCat", "pcSkills", "tags", "labels", "link",
		        "remoteWorkType", "languageRequirements", "major", "acceptRole", "snapshotDate",
		        "snapshotDateTime", "sourceKeyword", "sourceArea", "sourcePage", "sourcePageSize"}, MissingField.UseNull),
		    RawNames = {"salaryLow", "salaryHigh", "appearDate", "jobCat", "pcSkills", "tags", "labels", "link", "languageRequirements", "major", "acceptRole"},
		    Renamed = Table.RenameColumns(Selected, List.Transform(RawNames, each {_, _ & "Raw"})),
		    TextNames = {"jobNo", "custNo", "custName", "jobName", "description", "descSnippet", "jobAddress", "jobAddrNoDesc", "coIndustryDesc", "sourceKeyword", "sourceArea"},
		    NormalizedText = Table.TransformColumns(Renamed, List.Transform(TextNames, each {_, fxNormalizeText, type nullable text})),
		    InvalidKeys = Table.SelectRows(NormalizedText, each [jobNo] = null or [jobNo] = "" or [custNo] = null or [custNo] = ""),
		    RequiredKeys = if Table.RowCount(InvalidKeys) > 0 then
		        error Error.Record("Required job key", "jobNo and custNo must be non-empty scalar identifiers.", [Rows = Table.RowCount(InvalidKeys)]) else NormalizedText,
		    IntegerNames = {"coIndustry", "jobAddrNo", "applyCnt", "remoteWorkType", "sourcePage", "sourcePageSize"},
		    WithQuality = Table.AddColumn(RequiredKeys, "qualityIssues", each
		        let Current = _, Checks = List.Transform(IntegerNames & {"lat", "lon", "salaryLow", "salaryHigh"}, (name) =>
		            let Value = Record.Field(Current, if List.Contains({"salaryLow", "salaryHigh"}, name) then name & "Raw" else name),
		                Attempt = try fxStrictNumber(Value, List.Contains(IntegerNames, name))
		            in if Attempt[HasError] then name & ":invalid-number" else null)
		        in Text.Combine(List.RemoveNulls(Checks), ";"), type text),
		    TypedNumbers = Table.TransformColumns(WithQuality,
		        List.Transform(IntegerNames, each {_, (value) => try fxStrictNumber(value, true) otherwise null, Int64.Type}) &
		        List.Transform({"lat", "lon"}, each {_, (value) => try fxStrictNumber(value) otherwise null, type nullable number})),
		    WithSalaryLow = Table.AddColumn(TypedNumbers, "salaryLow", each try fxStrictNumber([salaryLowRaw]) otherwise null, type nullable number),
		    WithSalaryHigh = Table.AddColumn(WithSalaryLow, "salaryHigh", each try fxStrictNumber([salaryHighRaw]) otherwise null, type nullable number),
		    WithAppearDate = Table.AddColumn(WithSalaryHigh, "appearDate", each
		        let Value = fxNormalizeText([appearDateRaw]), Parsed = try
		            if Value <> null and Text.Length(Value) = 8 and Text.Select(Value, {"0".."9"}) = Value then
		                #date(Number.FromText(Text.Start(Value, 4)), Number.FromText(Text.Range(Value, 4, 2)), Number.FromText(Text.End(Value, 2)))
		            else null
		        in if Parsed[HasError] then null else Parsed[Value], type nullable date),
		    DateQuality = Table.AddColumn(WithAppearDate, "appearDateQuality", each
		        if [appearDateRaw] = null then "missing" else if [appearDate] = null then "invalid" else "valid", type text),
		    TypedSnapshot = Table.TransformColumns(DateQuality, {
		        {"snapshotDate", each Date.FromText(Text.Start(Text.From(_, "en-US"), 10), [Format = "yyyy-MM-dd", Culture = "en-US"]), type date},
		        {"snapshotDateTime", each DateTimeZone.RemoveZone(DateTimeZone.FromText(Text.From(_, "en-US"))), type datetime}}),
		    RequiredTechnical = Table.SelectRows(TypedSnapshot, each [snapshotDate] = null or [snapshotDateTime] = null or [sourcePage] = null or [sourcePageSize] = null),
		    Technical = if Table.RowCount(RequiredTechnical) > 0 then error Error.Record("Missing acquisition metadata", "Snapshot and page metadata are required.", null) else TypedSnapshot,
		    WithArea = Table.AddColumn(Technical, "areaKey", each fxAreaKey(_), type text),
		    WithLink = Table.AddColumn(WithArea, "jobLink", each
		        let Value = [linkRaw], Parsed = if Value = null then null else if Value.Is(Value, type record) then Value else Json.Document(Value),
		            Job = if Parsed = null then null else if Value.Is(Parsed, type record) then Record.FieldOrDefault(Parsed, "job", null) else
		                error Error.Record("Link shape", "link must be a record.", null),
		            Url = fxNormalizeText(Job)
		        in if Url = null then null else if Text.StartsWith(Url, "https://www.104.com.tw/") then Url else
		            error Error.Record("Unverified job URL", "Expected the observed 104 HTTPS URL; preserve the raw batch for review.", null), type nullable text)
		in
		    WithLink
		```
	lineageTag: dadecf7d-a18f-4ae2-a355-168d6c6ed3fc
	queryGroup: 01_Functions

expression fxStrictNumber = ```
		(value as any, optional requireInteger as nullable logical) as nullable number =>
		let
		    Parsed = if value = null then null else if Value.Is(value, type number) then value else
		        if Value.Is(value, type text) then Number.FromText(value, "en-US") else
		        error Error.Record("Numeric shape", "Expected number or numeric text.", null),
		    Validated = if Parsed = null then null else
		        if Number.IsNaN(Parsed) or Number.Abs(Parsed) = #infinity then
		            error Error.Record("Non-finite number", "Numbers must be finite.", null)
		        else if requireInteger = true and Number.RoundDown(Parsed) <> Parsed then
		            error Error.Record("Fractional integer", "Integer fields cannot be rounded.", null)
		        else Parsed
		in
		    Validated
		```
	lineageTag: 8aeb0a9d-7b74-461c-bbe0-96e64af16ae5
	queryGroup: 01_Functions

expression src_104CurrentManifest = ```
		let
		    Root = Text.TrimEnd(pSnapshotRoot, {"\", "/"}),
		    DefaultCurrent = try Json.Document(File.Contents(Root & "\current.json")) otherwise null,
		    ExpectedRequest = [baseUrl = pBaseUrl, keyword = pKeyword, area = pArea, jobsource = pJobSource, mode = pMode, order = pOrder, page = pPage, pagesize = pPageSize],
		    MatchesExpected = (m as any) as logical =>
		        Value.Is(m, type record) and
		        Record.FieldOrDefault(m, "schemaVersion", null) = 1 and
		        Value.Is(Record.FieldOrDefault(m, "request", null), type record) and
		        List.AllTrue(List.Transform(Record.FieldNames(ExpectedRequest), each Record.FieldOrDefault(m[request], _, null) = Record.Field(ExpectedRequest, _))),
		    SelectedManifest =
		        if MatchesExpected(DefaultCurrent) then DefaultCurrent
		        else
		            let
		                SeriesFolder = Root & "\series",
		                Files = try Folder.Files(SeriesFolder) otherwise null,
		                ManifestFiles = if Files = null then #table({}, {}) else Table.SelectRows(Files, each [Name] = "manifest.json"),
		                Parsed = Table.AddColumn(ManifestFiles, "manifest", each try Json.Document([Content]) otherwise null, type nullable record),
		                Matching = Table.SelectRows(Parsed, each MatchesExpected([manifest])),
		                Sorted = Table.Sort(Matching, {{"Date modified", Order.Descending}})
		            in
		                if Table.RowCount(Sorted) > 0 then Sorted{0}[manifest]
		                else error Error.Record("Snapshot parameters differ", "Capture a complete batch matching the Power Query parameters before refresh.", [keyword = pKeyword, area = pArea])
		in
		    SelectedManifest
		```
	lineageTag: 087e0b39-3ba5-4f2e-8362-463fa1049e2e
	queryGroup: 02_Source

expression src_104HistoryJobs = ```
		let
		    Root = Text.TrimEnd(pSnapshotRoot, {"\", "/"}),
		    Current = src_104CurrentManifest,
		    BatchFolder = Root & "\series\" & Current[seriesKey] & "\batches",
		    Files = Folder.Files(BatchFolder),
		    Manifests = Table.SelectRows(Files, each [Name] = "manifest.json"),
		    Parsed = Table.AddColumn(Manifests, "manifest", each Json.Document([Content]), type record),
		    SameSeries = Table.SelectRows(Parsed, each [manifest][seriesKey] = Current[seriesKey]),
		    WithDate = Table.AddColumn(SameSeries, "snapshotDay", each [manifest][snapshotDate], type text),
		    WithTime = Table.AddColumn(WithDate, "snapshotTime", each DateTimeZone.FromText([manifest][snapshotDateTime]), type datetimezone),
		    WithBatchId = Table.AddColumn(WithTime, "batchId", each [manifest][batchId], type text),
		    LatestDaily = Table.Group(WithBatchId, {"snapshotDay"}, {{"manifest", each Table.Sort(_, {{"snapshotTime", Order.Descending}, {"batchId", Order.Descending}}){0}[manifest], type record}}),
		    Jobs = Table.Combine(List.Transform(LatestDaily[manifest], each fx104ReadBatch(pSnapshotRoot, _)[Jobs])),
		    Output = if pSourceMode = "Live" then src_104Jobs else if pSourceMode = "Snapshot" then Jobs else error Error.Record("Invalid source mode", "Use Snapshot or Live.", null)
		in
		    Output
		```
	lineageTag: d6ac65db-5d1b-4348-8c71-3a85e4340eb5
	queryGroup: 02_Source


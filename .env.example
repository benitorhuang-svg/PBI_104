PBI104_POSTGRES_DB=jobwant_104
PBI104_POSTGRES_USER=pbi_admin
PBI104_POSTGRES_PORT=5433
PBI104_POSTGRES_PASSWORD=replace-with-a-random-local-secret
PBI104_GEOCODER_PORT=3301
PBI104_CAPTURE_DELAY_SECONDS=0.8
PBI104_CAPTURE_WORKERS=3
PBI104_CAPTURE_RUNTIME=host
PBI104_NO_PROXY=postgres,address-geocoder,localhost,127.0.0.1
# Optional container-mode proxies. Put actual values only in ignored .env.
PBI104_HTTP_PROXY=
PBI104_HTTPS_PROXY=
PBI104_ALL_PROXY=

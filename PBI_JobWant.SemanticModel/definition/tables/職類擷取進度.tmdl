table 職類擷取進度
	lineageTag: ea5d659f-c051-4254-bf26-6b9078701251

	measure 職類數 = COALESCE(COUNTROWS('職類擷取進度'), 0)
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: 6e68e075-73af-4615-94d4-0b051093b0a3

	measure 已選職類數 = COALESCE(SUMX(VALUES('職類擷取進度'[職缺平台]), CALCULATE(MAX('職類擷取進度'[選定職類數]))), 0)
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: 6c3e0f11-9489-4808-814d-88100decccb2

	measure 已完成職類數 = CALCULATE([職類數], '職類擷取進度'[佇列狀態] = "DONE")
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: d6441483-f57c-481b-9f99-4e27e09abc19

	measure 完成率 = DIVIDE([已完成職類數], [已選職類數], 0)
		formatString: 0.0%
		displayFolder: 擷取戰情室
		lineageTag: 3cef9b83-59fb-493d-9697-65215b084b0c

	measure 待處理職類數 = COALESCE(CALCULATE([職類數], '職類擷取進度'[佇列狀態] IN {"PENDING", "NOT_CAPTURED", "STALE"}), 0)
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: b8efaadb-0014-4185-9c80-08d6a9d30aa9

	measure 處理中職類數 = COALESCE(CALCULATE([職類數], '職類擷取進度'[佇列狀態] = "LEASED"), 0)
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: 53f07fe5-11be-4650-8107-98dda3136dbd

	measure 警告批次數 = COALESCE(SUM('職類擷取進度'[警告旗標]), 0)
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: 985bd872-ea2d-4d60-87d5-6c581cdba409

	measure 失敗職類數 = COALESCE(CALCULATE([職類數], '職類擷取進度'[佇列狀態] = "FAIL"), 0)
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: 32402fc3-21be-47d3-81b6-834c83103230

	measure 延後職類數 = COALESCE(CALCULATE([職類數], '職類擷取進度'[佇列狀態] = "DEFERRED"), 0)
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: ea660d24-b81d-437a-ab44-fdd8fda23e98

	measure 目前執行狀態 = VAR StatusText = CONCATENATEX(VALUES('職類擷取進度'[執行狀態]), SWITCH('職類擷取進度'[執行狀態], "QUEUED", "排隊中", "RUNNING", "執行中", "COMPLETE", "已完成", "COMPLETE_WITH_WARNINGS", "完成（有警告）", "PARTIAL", "部分完成", "BLOCKED", "已封鎖", "NOT_STARTED", "尚未開始", '職類擷取進度'[執行狀態]), " / ") RETURN IF(StatusText = "", "無執行紀錄", StatusText)
		formatString: @
		displayFolder: 擷取戰情室
		lineageTag: cee79c0f-be35-4434-9c89-8bbf8697510e

	measure 來源請求狀態 = IF(COUNTROWS('職類擷取進度') = 0, "無執行紀錄", IF(NOT HASONEVALUE('職類擷取進度'[職缺平台]), "請選擇單一平台", IF(COUNT('職類擷取進度'[閘道封鎖]) = 0, "來源端未提供", IF(MAX('職類擷取進度'[閘道封鎖]) = 1, "API 暫停", "API 可請求"))))
		formatString: @
		displayFolder: 擷取戰情室
		lineageTag: 9acd6da3-baae-4a66-8155-ddf51d655631

	measure 目前請求間隔秒最大值 = MAX('職類擷取進度'[目前請求間隔秒])
		formatString: 0.00
		displayFolder: 擷取戰情室
		lineageTag: cf2409b7-fde6-4fa2-8e01-4fa722807bc9

	measure 最新資料庫讀取時間 = MAX('職類擷取進度'[資料庫讀取時間])
		formatString: yyyy/MM/dd HH:mm:ss
		displayFolder: 擷取戰情室
		lineageTag: 73e63298-aca3-48f8-9a10-9cc6ca73a4ee

	measure 職缺總數 = COALESCE(SUM('職類擷取進度'[職缺筆數]), 0)
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: ce4615c2-ca18-49b1-b762-a09bca7f7834

	measure 來源職類名稱顯示 = VAR Platform = MAX('職類擷取進度'[職缺平台]) RETURN IF(Platform = "yes123", CALCULATE(SELECTEDVALUE('職類擷取進度'[來源職類名稱]), '職類擷取進度'[職類階層顯示用] = 0), SELECTEDVALUE('職類擷取進度'[來源職類名稱]))
		formatString: @
		lineageTag: fb471119-0cb2-4501-beb5-b2560cdf73e9

	measure 佇列終態職類數 = COALESCE(SUM('職類擷取進度'[佇列終態旗標]), 0)
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: f8fae507-6198-4c9b-9fbe-721c10f958d4

	measure 終態處理率 = DIVIDE([佇列終態職類數], [已選職類數], 0)
		formatString: 0.0%
		displayFolder: 擷取戰情室
		lineageTag: b0791d72-52be-4ed1-bdfd-a9193e6c15f4

	measure 分頁完整職類數 = COALESCE(SUM('職類擷取進度'[分頁完整旗標]), 0)
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: 6e094022-546e-42c5-8e43-c1655dc7169a

	measure Silver層可用職類數 = COALESCE(SUM('職類擷取進度'[Silver層可用旗標]), 0)
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: 23d767d8-7745-47de-bb11-09998c3c60a1

	measure Silver層封鎖職類數 = COALESCE(SUM('職類擷取進度'[Silver層封鎖旗標]), 0)
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: 5017c1f5-d7af-4fef-88f4-fbddf6f2fc79

	measure 分頁完整率 = DIVIDE([分頁完整職類數], [已選職類數], 0)
		formatString: 0.0%
		displayFolder: 擷取戰情室
		lineageTag: aec6c071-f639-4530-9872-bdc7a3235143

	measure 來源職類數 = VAR Platform = MAX('職類擷取進度'[職缺平台]) RETURN IF(Platform = "yes123", CALCULATE(COUNTROWS('職類擷取進度'), '職類擷取進度'[職類階層顯示用] = 0), COUNTROWS('職類擷取進度'))
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: 2bcf7fb6-01e3-4fc5-817c-aff1dfe7b3ea

	measure 來源職缺總數 = VAR Platform = MAX('職類擷取進度'[職缺平台]) RETURN IF(Platform = "yes123", CALCULATE(SUM('職類擷取進度'[職缺筆數]), '職類擷取進度'[職類階層顯示用] = 0), SUM('職類擷取進度'[職缺筆數]))
		formatString: #,0
		displayFolder: 擷取戰情室
		lineageTag: 45ebb793-b9b6-498d-8164-a106203ec150


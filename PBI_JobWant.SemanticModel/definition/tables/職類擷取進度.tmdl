		sourceColumn: sourcePlatform

	column 職類階層顯示用 =
			VAR Platform = '職類擷取進度'[職缺平台]
			VAR NativeCode = '職類擷取進度'[職類代碼]
			RETURN
				IF(
					Platform = "yes123" && LEFT(NativeCode, 2) = "2_",
					IF(RIGHT(NativeCode, 5) = "_0000", 0, 2),
					'職類擷取進度'[職類階層]
				)
		dataType: int64
		isHidden
		lineageTag: 734f64bb-16df-4f76-8de5-feb784070769
		summarizeBy: none

	column 來源職類代碼 =
			VAR Platform = '職類擷取進度'[職缺平台]
			VAR NativeCode = '職類擷取進度'[職類代碼]
			VAR ParentCode = '職類擷取進度'[來源職類代碼原始]
			RETURN
				IF(
					Platform = "yes123" && LEFT(NativeCode, 2) = "2_",
					"2_" & MID(NativeCode, 3, 9),
					ParentCode
				)
		dataType: string
		lineageTag: 4c9e25c4-1b6a-4f50-9aa1-99823c93f014
		summarizeBy: none

	partition FactAcquisitionCategory = m

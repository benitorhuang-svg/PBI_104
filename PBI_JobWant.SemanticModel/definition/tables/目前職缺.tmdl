table 目前職缺
	lineageTag: e01bc894-c60a-4e83-849b-cde9f0a28fda

	/// Distinct current jobNo values after optional skill/category filters. Multi-select within each bridge is OR; the two bridges intersect and other model filters remain intersections.
	measure 目前符合條件職缺數 =
			VAR HasSkillFilter = ISFILTERED('dim_技能'[技能名稱]) || ISFILTERED('dim_技能'[技能代碼])
			VAR HasCategoryFilter = ISFILTERED('dim_職類'[職類名稱]) || ISFILTERED('dim_職類'[職類代碼])
			RETURN
			    IF(
			        HasSkillFilter || HasCategoryFilter,
			        CALCULATE(
			            DISTINCTCOUNT('目前職缺'[職缺編號]),
			            CROSSFILTER('職缺技能對照'[職缺編號], '目前職缺'[職缺編號], BOTH),
			            CROSSFILTER('職缺職類對照'[職缺編號], '目前職缺'[職缺編號], BOTH)
			        ),
			        DISTINCTCOUNT('目前職缺'[職缺編號])
			    )
		formatString: #,0
		displayFolder: 職缺分析
		lineageTag: 5a72a91a-af34-48a4-8758-7e082876aa35

	/// Distinct companies in the currently matched job set.
	measure 符合條件公司數 = CALCULATE(DISTINCTCOUNT('目前職缺'[公司代碼]), CROSSFILTER('職缺技能對照'[職缺編號], '目前職缺'[職缺編號], BOTH), CROSSFILTER('職缺職類對照'[職缺編號], '目前職缺'[職缺編號], BOTH))
		formatString: #,0
		displayFolder: 職缺分析
		lineageTag: d79a642c-479c-4e17-b1fe-e81a5568ad8d

	/// Matched jobs with both numeric API salary bounds present; this does not interpret either bound as disclosed salary.
	measure 具備薪資上下限的職缺數 = CALCULATE(COUNTROWS(FILTER('目前職缺', NOT ISBLANK('目前職缺'[薪資下限]) && NOT ISBLANK('目前職缺'[薪資上限]))), CROSSFILTER('職缺技能對照'[職缺編號], '目前職缺'[職缺編號], BOTH), CROSSFILTER('職缺職類對照'[職缺編號], '目前職缺'[職缺編號], BOTH))
		formatString: #,0
		displayFolder: 職缺分析
		lineageTag: ddd9a331-14db-43b8-9316-6e0da72efdc2

	/// Matched jobs with both raw numeric salary bounds divided by matched current jobs.
	measure 薪資上下限涵蓋率 = DIVIDE([具備薪資上下限的職缺數], [目前符合條件職缺數], 0)
		formatString: 0.0%
		displayFolder: 職缺分析
		lineageTag: 1a453a7e-4a28-4c7b-b5b0-9fced4a7ca4d

	/// Distinct jobs matching the selected normalized skill set and all other filters.
	measure 技能篩選職缺數 = [目前符合條件職缺數]
		formatString: #,0
		displayFolder: 職缺分析
		lineageTag: cac87f8d-6ddc-4a9f-bd2f-86fab1d4368c

	/// Share of matched jobs associated with the selected normalized skills; describes association, not causation.
	measure 技能職缺占比 = DIVIDE([技能篩選職缺數], CALCULATE([目前符合條件職缺數], REMOVEFILTERS('dim_技能')), 0)
		formatString: 0.0%
		displayFolder: 職缺分析
		lineageTag: fbac9dd5-be67-471f-8cc8-0f0d3537c804

	/// Distinct jobs matching the selected observed category codes and all other filters.
	measure 職類篩選職缺數 = [目前符合條件職缺數]
		formatString: #,0
		displayFolder: 職缺分析
		lineageTag: c314b901-7fa2-4be0-82a1-a7b2184c901e

	/// Share of matched jobs associated with the selected category codes.
	measure 職類職缺占比 = DIVIDE([職類篩選職缺數], CALCULATE([目前符合條件職缺數], REMOVEFILTERS('dim_職類')), 0)
		formatString: 0.0%
		displayFolder: 職缺分析
		lineageTag: d85a2104-51bc-4e4b-9e0a-bf1930b8c6e2

	/// Distinct normalized skill descriptions for the currently selected job.
	measure 職缺技能清單 =
			VAR SkillNames = CALCULATETABLE(VALUES('職缺技能對照'[技能名稱]), CROSSFILTER('職缺技能對照'[職缺編號], '目前職缺'[職缺編號], BOTH))
			RETURN CONCATENATEX(FILTER(SkillNames, NOT ISBLANK([技能名稱])), [技能名稱], ", ", [技能名稱], ASC)
		formatString: @
		displayFolder: 職缺分析
		lineageTag: 732335da-adee-4143-9b7a-f47b31082ad4

	/// Company name resolved from the currently selected job.
	measure 所選職缺公司名稱 =
			VAR CompanyName = CALCULATE(SELECTEDVALUE('dim_公司'[公司名稱]), CROSSFILTER('目前職缺'[公司代碼], 'dim_公司'[公司代碼], BOTH))
			RETURN COALESCE(CompanyName, "來源未提供")
		formatString: @
		displayFolder: 職缺分析\所選職缺
		lineageTag: 1e8ac704-b889-4b8a-9be3-4a1d516dabec


table FactJob
	lineageTag: e01bc894-c60a-4e83-849b-cde9f0a28fda

	/// Distinct current jobNo values after optional skill/category filters. Multi-select within each bridge is OR; the two bridges intersect and other model filters remain intersections.
	measure 'Active Jobs' =
			VAR HasSkillFilter = ISFILTERED(DimSkill[skillDescription]) || ISFILTERED(DimSkill[skillCode])
			VAR HasCategoryFilter = ISFILTERED(DimJobCategory[jobCatDescription]) || ISFILTERED(DimJobCategory[jobCatCode])
			RETURN
			    IF(
			        HasSkillFilter || HasCategoryFilter,
			        CALCULATE(
			            DISTINCTCOUNT(FactJob[jobNo]),
			            CROSSFILTER(BridgeJobSkill[jobNo], FactJob[jobNo], BOTH),
			            CROSSFILTER(BridgeJobCategory[jobNo], FactJob[jobNo], BOTH)
			        ),
			        DISTINCTCOUNT(FactJob[jobNo])
			    )
		formatString: #,0
		displayFolder: Jobs
		lineageTag: 5a72a91a-af34-48a4-8758-7e082876aa35

	/// Distinct companies in the currently matched job set.
	measure 'Company Count' = CALCULATE(DISTINCTCOUNT(FactJob[custNo]), CROSSFILTER(BridgeJobSkill[jobNo], FactJob[jobNo], BOTH), CROSSFILTER(BridgeJobCategory[jobNo], FactJob[jobNo], BOTH))
		formatString: #,0
		displayFolder: Jobs
		lineageTag: d79a642c-479c-4e17-b1fe-e81a5568ad8d

	/// Matched jobs with both numeric API salary bounds present; this does not interpret either bound as disclosed salary.
	measure 'Jobs with Salary' = CALCULATE(COUNTROWS(FILTER(FactJob, NOT ISBLANK(FactJob[salaryLow]) && NOT ISBLANK(FactJob[salaryHigh]))), CROSSFILTER(BridgeJobSkill[jobNo], FactJob[jobNo], BOTH), CROSSFILTER(BridgeJobCategory[jobNo], FactJob[jobNo], BOTH))
		formatString: #,0
		displayFolder: Jobs
		lineageTag: ddd9a331-14db-43b8-9316-6e0da72efdc2

	/// Matched jobs with both raw numeric salary bounds divided by matched current jobs.
	measure 'Salary Coverage %' = DIVIDE([Jobs with Salary], [Active Jobs], 0)
		formatString: 0.0%
		displayFolder: Jobs
		lineageTag: 1a453a7e-4a28-4c7b-b5b0-9fced4a7ca4d

	/// Distinct jobs matching the selected normalized skill set and all other filters.
	measure 'Skill Job Count' = [Active Jobs]
		formatString: #,0
		displayFolder: Jobs
		lineageTag: cac87f8d-6ddc-4a9f-bd2f-86fab1d4368c

	/// Share of matched jobs associated with the selected normalized skills; describes association, not causation.
	measure 'Skill Share %' = DIVIDE([Skill Job Count], CALCULATE([Active Jobs], REMOVEFILTERS(DimSkill)), 0)
		formatString: 0.0%
		displayFolder: Jobs
		lineageTag: fbac9dd5-be67-471f-8cc8-0f0d3537c804

	/// Distinct jobs matching the selected observed category codes and all other filters.
	measure 'Category Job Count' = [Active Jobs]
		formatString: #,0
		displayFolder: Jobs
		lineageTag: c314b901-7fa2-4be0-82a1-a7b2184c901e

	/// Share of matched jobs associated with the selected category codes.
	measure 'Category Share %' = DIVIDE([Category Job Count], CALCULATE([Active Jobs], REMOVEFILTERS(DimJobCategory)), 0)
		formatString: 0.0%
		displayFolder: Jobs
		lineageTag: d85a2104-51bc-4e4b-9e0a-bf1930b8c6e2

	/// Distinct normalized skill descriptions for the currently selected job.
	measure 'Job Skills' =
			VAR SkillNames = CALCULATETABLE(VALUES(BridgeJobSkill[skillDescription]), CROSSFILTER(BridgeJobSkill[jobNo], FactJob[jobNo], BOTH))
			RETURN CONCATENATEX(FILTER(SkillNames, NOT ISBLANK([skillDescription])), [skillDescription], ", ", [skillDescription], ASC)
		formatString: @
		displayFolder: Jobs
		lineageTag: 732335da-adee-4143-9b7a-f47b31082ad4


	partition 查詢 = m
		mode: import
		source =
				let
				    // ============================================================
				    // 104 Job Search API
				    // Raw / Staging Query
				    // ============================================================
				
				    來源 =
				        Python.Execute(
				"
				import pandas as pd
				import cloudscraper
				import urllib.request
				import json
				from datetime import datetime
				
				# ============================================================
				# 1. API Parameters
				# ============================================================
				
				BASE_URL = 'https://www.104.com.tw/jobs/search/api/jobs'
				
				AREA = '6001008007,6001008006'
				KEYWORD = 'powerbi'
				PAGE = 1
				PAGE_SIZE = 20
				
				params = {
				    'area': AREA,
				    'jobsource': 'index_s',
				    'keyword': KEYWORD,
				    'mode': 's',
				    'order': '15',
				    'page': PAGE,
				    'pagesize': PAGE_SIZE
				}
				
				headers = {
				    'Accept': 'application/json, text/plain, */*',
				    'Accept-Language': 'zh-TW,zh;q=0.9,en-US;q=0.8,en;q=0.7',
				    'Referer': 'https://www.104.com.tw/jobs/search/'
				}
				
				
				# ============================================================
				# 2. Windows System Proxy
				# ============================================================
				
				sys_proxies = urllib.request.getproxies()
				
				scraper = cloudscraper.create_scraper(
				    browser={
				        'browser': 'chrome',
				        'platform': 'windows',
				        'desktop': True
				    }
				)
				
				# 只注入 HTTP / HTTPS Proxy
				if sys_proxies:
				    valid_proxies = {
				        key: value
				        for key, value in sys_proxies.items()
				        if key.lower() in ('http', 'https')
				    }
				
				    if valid_proxies:
				        scraper.proxies.update(valid_proxies)
				
				
				# ============================================================
				# 3. Snapshot Time
				# ============================================================
				
				snapshot_dt = datetime.now().astimezone()
				snapshot_date = snapshot_dt.date().isoformat()
				snapshot_datetime = snapshot_dt.isoformat(timespec='seconds')
				
				
				# ============================================================
				# 4. Call API
				# ============================================================
				
				response = scraper.get(
				    BASE_URL,
				    params=params,
				    headers=headers,
				    timeout=30
				)
				
				response.raise_for_status()
				
				json_data = response.json()
				
				
				# ============================================================
				# 5. Locate Job List
				# ============================================================
				
				jobs_list = []
				data_node = None
				
				if isinstance(json_data, list):
				
				    jobs_list = json_data
				
				elif isinstance(json_data, dict):
				
				    data_node = json_data.get('data', json_data)
				
				    if isinstance(data_node, list):
				
				        jobs_list = data_node
				
				    elif isinstance(data_node, dict):
				
				        # 兼容 API 未來可能修改 list key
				        for candidate in ['list', 'jobs', 'items']:
				
				            candidate_value = data_node.get(candidate)
				
				            if isinstance(candidate_value, list):
				                jobs_list = candidate_value
				                break
				
				
				# ============================================================
				# 6. Jobs -> DataFrame
				# ============================================================
				
				if jobs_list:
				
				    # dict 欄位直接展開，例如 company.xxx
				    df_jobs = pd.json_normalize(
				        jobs_list,
				        sep='.'
				    )
				
				else:
				
				    # 正常沒有資料時回傳空表，而不是製造假的職缺紀錄
				    df_jobs = pd.DataFrame()
				
				
				# ============================================================
				# 7. Complex Columns -> Valid JSON String
				# ============================================================
				
				# Power BI Python Connector 對 list/dict 欄位支援不好，
				# 暫時保存為合法 JSON。
				# 後續再針對 pcSkills / tags / jobCat 等拆成子表。
				
				for col in df_jobs.columns:
				
				    has_complex_value = df_jobs[col].map(
				        lambda x: isinstance(x, (dict, list))
				    ).any()
				
				    if has_complex_value:
				
				        df_jobs[col] = df_jobs[col].map(
				            lambda x:
				                json.dumps(
				                    x,
				                    ensure_ascii=False
				                )
				                if isinstance(x, (dict, list))
				                else x
				        )
				
				
				# ============================================================
				# 8. ETL Audit Columns
				# ============================================================
				
				df_jobs['snapshotDate'] = snapshot_date
				df_jobs['snapshotDateTime'] = snapshot_datetime
				
				df_jobs['sourceKeyword'] = KEYWORD
				df_jobs['sourceArea'] = AREA
				df_jobs['sourcePage'] = PAGE
				df_jobs['sourcePageSize'] = PAGE_SIZE
				
				
				# ============================================================
				# 9. API Metadata
				# ============================================================
				
				def safe_keys(value):
				    if isinstance(value, dict):
				        return json.dumps(
				            list(value.keys()),
				            ensure_ascii=False
				        )
				    return None
				
				
				metadata = {
				    'httpStatus': response.status_code,
				    'requestUrl': response.url,
				    'snapshotDate': snapshot_date,
				    'snapshotDateTime': snapshot_datetime,
				    'keyword': KEYWORD,
				    'area': AREA,
				    'requestedPage': PAGE,
				    'requestedPageSize': PAGE_SIZE,
				    'returnedJobs': len(jobs_list),
				    'topLevelKeys': safe_keys(json_data),
				    'dataKeys': safe_keys(data_node)
				}
				
				
				# 嘗試取得 API 中常見的 Pagination / Count 欄位
				if isinstance(data_node, dict):
				
				    for key in [
				        'totalCount',
				        'totalPage',
				        'page',
				        'pageSize',
				        'total',
				        'count'
				    ]:
				
				        if key in data_node:
				            metadata[key] = data_node.get(key)
				
				
				if isinstance(json_data, dict):
				
				    for key in [
				        'totalCount',
				        'totalPage',
				        'page',
				        'pageSize',
				        'total',
				        'count'
				    ]:
				
				        if key in json_data and key not in metadata:
				            metadata[key] = json_data.get(key)
				
				
				df_metadata = pd.DataFrame([metadata])
				"
				        ),
				
				    // ============================================================
				    // 10. Select Jobs DataFrame
				    // ============================================================
				
				    df_jobs =
				        來源{[Name = "df_jobs"]}[Value],
				
				
				    // ============================================================
				    // 11. Robust Power Query Types
				    // 欄位不存在時不會報錯
				    // ============================================================
				
				    欄位清單 =
				        Table.ColumnNames(df_jobs),
				
				
				    Int欄位 = {
				        "appearDate",
				        "applyCnt",
				        "coIndustry",
				        "custNo",
				        "jobAddrNo",
				        "jobNo",
				        "jobRo",
				        "jobType",
				        "mrt",
				        "period",
				        "remoteWorkType",
				        "s10",
				        "salaryHigh",
				        "salaryLow",
				        "s5",
				        "employeeCount",
				        "sourcePage",
				        "sourcePageSize"
				    },
				
				
				    Number欄位 = {
				        "mrtDist",
				        "lat",
				        "lon",
				        "hrBehaviorPR",
				        "pddScore"
				    },
				
				
				    Text欄位 = {
				        "coIndustryDesc",
				        "custName",
				        "description",
				        "descSnippet",
				        "jobAddress",
				        "jobAddrNoDesc",
				        "jobName",
				        "jobNameSnippet",
				        "link",
				        "major",
				        "mrtDesc",
				        "optionEdu",
				        "tags",
				        "s9",
				        "d3",
				        "jobCat",
				        "labels",
				        "languageRequirements",
				        "acceptRole",
				        "pcSkills",
				        "custLogo",
				        "jobSwitch",
				        "isSave",
				        "interactionRecord",
				        "isApplied",
				        "applyDate",
				        "userApplyCount",
				        "sourceKeyword",
				        "sourceArea"
				    },
				
				
				    // ------------------------------------------------------------
				    // Int64
				    // ------------------------------------------------------------
				
				    Int轉換 =
				        List.Transform(
				            List.Select(
				                Int欄位,
				                each List.Contains(欄位清單, _)
				            ),
				            (欄位名稱) =>
				                {
				                    欄位名稱,
				                    each try Int64.From(_) otherwise null,
				                    Int64.Type
				                }
				        ),
				
				
				    // ------------------------------------------------------------
				    // Decimal Number
				    // ------------------------------------------------------------
				
				    Number轉換 =
				        List.Transform(
				            List.Select(
				                Number欄位,
				                each List.Contains(欄位清單, _)
				            ),
				            (欄位名稱) =>
				                {
				                    欄位名稱,
				                    each try Number.From(_) otherwise null,
				                    type number
				                }
				        ),
				
				
				    // ------------------------------------------------------------
				    // Text
				    // ------------------------------------------------------------
				
				    Text轉換 =
				        List.Transform(
				            List.Select(
				                Text欄位,
				                each List.Contains(欄位清單, _)
				            ),
				            (欄位名稱) =>
				                {
				                    欄位名稱,
				                    each
				                        if _ = null
				                        then null
				                        else Text.From(_),
				                    type text
				                }
				        ),
				
				
				    // ------------------------------------------------------------
				    // Apply transformations
				    // ------------------------------------------------------------
				
				    基礎類型 =
				        Table.TransformColumns(
				            df_jobs,
				            List.Combine({
				                Int轉換,
				                Number轉換,
				                Text轉換
				            })
				        ),
				
				
				    // ============================================================
				    // 12. Snapshot Types
				    // ============================================================
				
				    SnapshotDateType =
				        if List.Contains(
				            Table.ColumnNames(基礎類型),
				            "snapshotDate"
				        )
				        then
				            Table.TransformColumns(
				                基礎類型,
				                {
				                    {
				                        "snapshotDate",
				                        each try Date.From(_) otherwise null,
				                        type date
				                    }
				                }
				            )
				        else
				            基礎類型,
				
				
				    SnapshotDateTimeType =
				        if List.Contains(
				            Table.ColumnNames(SnapshotDateType),
				            "snapshotDateTime"
				        )
				        then
				            Table.TransformColumns(
				                SnapshotDateType,
				                {
				                    {
				                        "snapshotDateTime",
				                        each
				                            try DateTimeZone.From(_)
				                            otherwise null,
				                        type datetimezone
				                    }
				                }
				            )
				        else
				            SnapshotDateType
				
				in
				    SnapshotDateTimeType

	annotation PBI_NavigationStepName = 導覽

	annotation PBI_ResultType = Table

